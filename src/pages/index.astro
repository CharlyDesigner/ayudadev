---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/ui/Icon.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import RecursoCard from '@components/biblioteca/RecursoCard.astro';
import NewsletterForm from '@components/newsletter/NewsletterForm.astro';
import { SITE } from '@data/site';
import { AREAS_INFO } from '@data/areas';
import { TEMAS, temasPorArea } from '@data/temas';
import { RECURSOS, conteoPorArea, recursosDestacados } from '@data/library';
import { fechaCorta } from '@lib/dates';

const porArea = conteoPorArea();
const destacados = recursosDestacados(6);
const guias = (await getCollection('guias', (g) => !g.data.borrador)).sort((a, b) => a.data.orden - b.data.orden).slice(0, 6);
const ia = (await getCollection('ia', (h) => !h.data.borrador)).sort((a, b) => a.data.orden - b.data.orden).slice(0, 6);
const noticias = (await getCollection('noticias', (n) => !n.data.borrador)).sort((a, b) => b.data.publicado.getTime() - a.data.publicado.getTime()).slice(0, 3);
const totalGuias = (await getCollection('guias', (g) => !g.data.borrador)).length;
const sugerencias = ['javascript', 'python', 'html-css', 'git', 'sql', 'inteligencia-artificial'].map((s) => TEMAS.find((t) => t.slug === s)).filter(Boolean);
---

<BaseLayout title={`${SITE.nombre}: ${SITE.lema}`} description={SITE.descripcion} path="/">
  <!-- Hero -->
  <section class="bg-glow">
    <div class="container-site flex flex-col items-center py-16 text-center sm:py-24">
      <p class="eyebrow reveal">Gratis, en español y sin registro</p>
      <h1 class="reveal reveal-delay-1 mt-5 max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-6xl">
        Aprende a programar con <span class="text-accent-ink">recursos gratis</span>, guías con ejemplos e IA
      </h1>
      <p class="reveal reveal-delay-2 mt-5 max-w-2xl text-lg text-pretty text-muted">
        {RECURSOS.length} libros, cursos y documentación curados en {TEMAS.length} temas. Guías paso a paso que puedes copiar y ejecutar. Y un apartado para aprender con Claude, ChatGPT, Gemini y más.
      </p>

      <div class="reveal reveal-delay-3 mt-8 w-full max-w-xl">
        <button type="button" data-command-open class="field flex items-center gap-3 text-left text-muted shadow-lg shadow-black/10 hover:border-fg">
          <Icon name="search" class="h-5 w-5 shrink-0" />
          <span class="flex-1">Busca un tema, lenguaje o herramienta...</span>
          <kbd class="hidden sm:inline">Ctrl K</kbd>
        </button>
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          {sugerencias.map((t) => t && <a href={`/biblioteca/${t.slug}/`} class="chip">{t.nombre}</a>)}
        </div>
      </div>

      <dl class="mt-12 grid w-full max-w-3xl grid-cols-2 gap-3 sm:grid-cols-4">
        {[
          [String(RECURSOS.length), 'recursos'],
          [String(TEMAS.length), 'temas'],
          [String(totalGuias), 'guías con ejemplos'],
          ['0 $', 'siempre'],
        ].map(([n, l]) => (
          <div class="card p-4">
            <dt class="text-xs text-muted">{l}</dt>
            <dd class="text-2xl font-bold tracking-tight">{n}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Áreas -->
  <section class="container-site py-12" aria-labelledby="areas-titulo">
    <SectionHeader eyebrow="Biblioteca" titulo="Explora por área" descripcion="Cada tema enlaza a recursos verificados y, cuando existe, a su guía con ejemplos." enlace={{ href: '/biblioteca/', label: 'Ver toda la biblioteca' }} />
    <div id="areas-titulo" class="visually-hidden">Áreas</div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {AREAS_INFO.map((area) => {
        const temas = temasPorArea(area.id);
        return (
          <div class="card flex flex-col p-5">
            <div class="flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-2xl bg-accent text-on-accent"><Icon name={area.icono as any} class="h-5 w-5" /></span>
              <div>
                <h3 class="font-semibold">{area.nombre}</h3>
                <p class="text-xs text-muted">{porArea.get(area.id) ?? 0} recursos</p>
              </div>
            </div>
            <p class="mt-3 text-sm text-muted">{area.descripcion}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {temas.map((t) => (
                <li><a href={`/biblioteca/${t.slug}/`} class="chip">{t.nombre}</a></li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Guías -->
  {guias.length > 0 && (
    <section class="container-site py-12" aria-labelledby="guias-titulo">
      <SectionHeader eyebrow="Guías con ejemplos" titulo="Empieza hoy con código que puedes ejecutar" descripcion="Modelo mental, instalación en 5 minutos, ejemplos comentados, trampas comunes y los libros gratis para seguir." enlace={{ href: '/guias/', label: 'Todas las guías' }} />
      <div id="guias-titulo" class="visually-hidden">Guías</div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {guias.map((g) => {
          const tema = TEMAS.find((t) => t.slug === g.data.tema);
          return (
            <a href={`/guias/${g.id}/`} class="card card-hover group flex flex-col gap-3 p-5">
              <div class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-2xl bg-surface-2 text-accent-ink group-hover:bg-accent group-hover:text-on-accent"><Icon name={(tema?.icono ?? 'code') as any} class="h-5 w-5" /></span>
                <span class="badge">{g.data.nivel}</span>
              </div>
              <h3 class="text-lg font-semibold">{g.data.titulo}</h3>
              <p class="text-sm text-muted">{g.data.descripcion}</p>
              <span class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-accent-ink">Leer la guía <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" /></span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- IA -->
  <section class="container-site py-12" aria-labelledby="ia-titulo">
    <div class="card bg-glow overflow-hidden p-6 sm:p-10">
      <SectionHeader eyebrow="Inteligencia artificial" titulo="Aprende con IA sin depender de ella" descripcion="Fichas de Claude, ChatGPT, Gemini, Copilot y más. Prompts listos para copiar, una comparativa honesta y guías para usar la IA como tutor, no como atajo." enlace={{ href: '/ia/', label: 'Ir al apartado de IA' }} />
      <div id="ia-titulo" class="visually-hidden">IA</div>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {ia.length > 0
          ? ia.map((h) => (
              <a href={`/ia/${h.id}/`} class="card card-hover flex items-center gap-3 p-4">
                <span class="grid h-10 w-10 place-items-center rounded-2xl bg-surface-2 text-accent-ink"><Icon name="robot" class="h-5 w-5" /></span>
                <span class="min-w-0"><span class="block font-semibold">{h.data.nombre}</span><span class="block truncate text-xs text-muted">{h.data.empresa}</span></span>
              </a>
            ))
          : [
              ['Prompts para aprender', '/ia/prompts/', 'bulb'],
              ['Comparativa de herramientas', '/ia/comparativa/', 'layers'],
              ['Aprende con IA', '/ia/aprende/', 'school'],
            ].map(([l, h, i]) => (
              <a href={h} class="card card-hover flex items-center gap-3 p-4">
                <span class="grid h-10 w-10 place-items-center rounded-2xl bg-surface-2 text-accent-ink"><Icon name={i as any} class="h-5 w-5" /></span>
                <span class="font-semibold">{l}</span>
              </a>
            ))}
      </div>
    </div>
  </section>

  <!-- Destacados -->
  {destacados.length > 0 && (
    <section class="container-site py-12" aria-labelledby="destacados-titulo">
      <SectionHeader eyebrow="Recomendados" titulo="Recursos destacados" descripcion="Los que más recomendamos para empezar en cada área." />
      <div id="destacados-titulo" class="visually-hidden">Destacados</div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {destacados.map((r) => <RecursoCard recurso={r} mostrarTema />)}
      </div>
    </section>
  )}

  <!-- Noticias -->
  {noticias.length > 0 && (
    <section class="container-site py-12" aria-labelledby="noticias-titulo">
      <SectionHeader eyebrow="Noticias" titulo="Novedades del proyecto y del mundo dev" enlace={{ href: '/noticias/', label: 'Todas las noticias' }} />
      <div id="noticias-titulo" class="visually-hidden">Noticias</div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {noticias.map((n) => (
          <a href={`/noticias/${n.id}/`} class="card card-hover flex flex-col gap-2 p-5">
            <time datetime={n.data.publicado.toISOString()} class="text-xs text-muted">{fechaCorta(n.data.publicado)}</time>
            <h3 class="font-semibold">{n.data.titulo}</h3>
            <p class="text-sm text-muted">{n.data.descripcion}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Newsletter + Apoyo -->
  <section class="container-site grid gap-4 py-12 lg:grid-cols-2">
    <NewsletterForm />
    <div class="card flex flex-col gap-4 p-6 sm:p-8">
      <div>
        <h2 class="text-xl font-bold tracking-tight">Apoya el proyecto</h2>
        <p class="mt-1 text-sm text-muted">AyudaDev es gratis y sin anuncios. Las donaciones voluntarias pagan el hosting y el tiempo de curar y escribir. También ayudas compartiendo o proponiendo recursos.</p>
      </div>
      <div class="mt-auto flex flex-wrap gap-2">
        <a href="/apoya/" class="btn btn-primary"><Icon name="heart" class="h-4 w-4" /> Donar</a>
        <a href="/enviar-recurso/" class="btn btn-secondary">Proponer un recurso</a>
        <a href={SITE.repo} rel="noopener" target="_blank" class="btn btn-ghost"><Icon name="github" class="h-4 w-4" /> Dar estrella</a>
      </div>
    </div>
  </section>
</BaseLayout>
