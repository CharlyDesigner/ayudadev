---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Icon from '@components/ui/Icon.astro';
import { SITE } from '@data/site';

const migas = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Mi cuenta', href: '/cuenta/' },
];
---

<BaseLayout title="Mi cuenta" description="Entra a tu cuenta de AyudaDev para llevar tu progreso y tus favoritos a cualquier dispositivo." path="/cuenta/" noindex>
  <div class="container-site py-10 sm:py-14">
    <Breadcrumbs migas={migas} class="mb-6" />
    <SectionHeader nivel="h1" eyebrow="Cuenta (opcional)" titulo="Mi cuenta" descripcion="No la necesitas para usar AyudaDev. Con una cuenta, tu progreso y tus favoritos te siguen a cualquier dispositivo." />

    <p data-cta-aviso role="status" aria-live="polite" hidden></p>

    <!-- Entrar -->
    <section data-vista="entrar" hidden class="mt-8 max-w-md">
      <form class="card flex flex-col gap-4 p-6" data-cta-form="entrar" novalidate>
        <h2 class="text-xl font-bold tracking-tight">Entrar</h2>
        <label class="block text-sm font-medium">
          Correo electrónico
          <input type="email" name="email" class="field mt-1" required autocomplete="username" inputmode="email" placeholder="tu@correo.com" />
        </label>
        <label class="block text-sm font-medium">
          Contraseña
          <input type="password" name="clave" class="field mt-1" required autocomplete="current-password" maxlength="1024" data-cta-clave />
        </label>
        <label class="flex items-center gap-2 text-sm text-muted"><input type="checkbox" data-cta-mostrar class="accent-[var(--ad-accent)]" /> Mostrar contraseña</label>
        <button type="submit" class="btn btn-primary justify-center">Entrar</button>
        <p data-cta-error class="text-sm text-danger" aria-live="polite" hidden></p>
        <a href="/api/cuenta-github.php" data-cta-github class="btn btn-secondary justify-center" hidden><Icon name="github" class="h-4 w-4" /> Entrar con GitHub</a>
        <p class="text-sm text-muted"><a href="/cuenta/clave/" class="link">Olvidé mi contraseña</a></p>
      </form>
      <p class="mt-4 text-sm text-muted">¿Primera vez? <a href="/cuenta/registro/" class="link">Crear una cuenta</a></p>
    </section>

    <!-- Código del doble factor -->
    <section data-vista="codigo" hidden class="mt-8 max-w-md">
      <form class="card flex flex-col gap-4 p-6" data-cta-form="codigo" novalidate>
        <h2 class="text-xl font-bold tracking-tight">Código de verificación</h2>
        <p class="text-sm text-muted">Escribe el código de 6 dígitos de tu app de autenticación. Si perdiste el teléfono, usa uno de tus códigos de respaldo.</p>
        <label class="block text-sm font-medium">
          Código
          <input type="text" name="codigo" class="field mt-1 tracking-widest" required autocomplete="one-time-code" inputmode="text" autocapitalize="characters" spellcheck="false" maxlength="16" />
        </label>
        <button type="submit" class="btn btn-primary justify-center">Verificar</button>
        <p data-cta-error class="text-sm text-danger" aria-live="polite" hidden></p>
        <p class="text-xs text-muted">¿Sin app y sin códigos de respaldo? Escríbenos a <a href={`mailto:${SITE.contacto}`} class="link">{SITE.contacto}</a> y lo resolvemos a mano.</p>
      </form>
    </section>

    <!-- Panel -->
    <div data-vista="panel" hidden class="mt-8 grid gap-6 lg:grid-cols-2">
      <section class="card p-6 lg:col-span-2" aria-labelledby="cta-resumen">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h2 id="cta-resumen" class="text-xl font-bold tracking-tight" data-cta-saludo>Tu cuenta</h2>
            <p class="mt-1 text-sm text-muted" data-cta-correo></p>
            <p class="mt-3 text-sm" data-cta-sync></p>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" data-cta-salir>Cerrar sesión</button>
        </div>
      </section>

      <section class="card p-6" aria-labelledby="cta-clave-titulo">
        <h2 id="cta-clave-titulo" class="text-lg font-semibold">Contraseña</h2>
        <p class="mt-1 text-sm text-muted" data-cta-clave-estado></p>
        <form class="mt-4 flex flex-col gap-3" data-cta-form="clave" novalidate>
          <label class="block text-sm font-medium" data-cta-clave-actual>
            Contraseña actual
            <input type="password" name="actual" class="field mt-1" autocomplete="current-password" maxlength="1024" data-cta-clave />
          </label>
          <label class="block text-sm font-medium">
            Contraseña nueva
            <input type="password" name="nueva" class="field mt-1" required minlength="10" maxlength="200" autocomplete="new-password" data-cta-clave />
          </label>
          <label class="flex items-center gap-2 text-sm text-muted"><input type="checkbox" data-cta-mostrar class="accent-[var(--ad-accent)]" /> Mostrar contraseñas</label>
          <button type="submit" class="btn btn-secondary justify-center" data-cta-clave-boton>Cambiar contraseña</button>
          <p data-cta-error class="text-sm text-danger" aria-live="polite" hidden></p>
        </form>
      </section>

      <section class="card p-6" aria-labelledby="cta-tfa-titulo">
        <h2 id="cta-tfa-titulo" class="text-lg font-semibold">Doble factor (TOTP)</h2>
        <p class="mt-1 text-sm text-muted">Un código de 6 dígitos de una app como Google Authenticator, Authy o 1Password, además de tu contraseña.</p>

        <div data-tfa="apagado" hidden class="mt-4">
          <form class="flex flex-col gap-3" data-cta-form="tfa-iniciar" novalidate>
            <label class="block text-sm font-medium" data-cta-clave-actual>
              Tu contraseña
              <input type="password" name="clave" class="field mt-1" autocomplete="current-password" maxlength="1024" />
            </label>
            <button type="submit" class="btn btn-secondary justify-center">Activar doble factor</button>
            <p data-cta-error class="text-sm text-danger" aria-live="polite" hidden></p>
          </form>
        </div>

        <div data-tfa="configurar" hidden class="mt-4 flex flex-col gap-4">
          <ol class="list-decimal space-y-1 pl-5 text-sm text-muted">
            <li>Escanea el código QR con tu app, o escribe la clave a mano.</li>
            <li>Escribe aquí el código de 6 dígitos que muestre la app.</li>
          </ol>
          <div class="flex flex-wrap items-center gap-4">
            <div data-cta-qr class="rounded-2xl bg-white p-1 text-black" role="img" aria-label="Código QR para tu app de autenticación"></div>
            <div class="min-w-0 text-sm">
              <p class="text-muted">Clave para escribir a mano:</p>
              <p class="mt-1 break-all font-mono text-base tracking-wider" data-cta-secreto></p>
              <a class="link mt-2 inline-block" data-cta-otp-enlace href="#">Abrir en mi app</a>
            </div>
          </div>
          <form class="flex flex-col gap-3" data-cta-form="tfa-activar" novalidate>
            <label class="block text-sm font-medium">
              Código de la app
              <input type="text" name="codigo" class="field mt-1 tracking-widest" required inputmode="numeric" autocomplete="one-time-code" maxlength="7" />
            </label>
            <button type="submit" class="btn btn-primary justify-center">Confirmar y activar</button>
            <p data-cta-error class="text-sm text-danger" aria-live="polite" hidden></p>
          </form>
        </div>

        <div data-tfa="respaldo" hidden class="mt-4 flex flex-col gap-3">
          <h3 class="text-sm font-semibold">Guarda tus códigos de respaldo</h3>
          <p class="text-sm text-muted">Cada uno sirve una sola vez si pierdes tu teléfono. Es la única vez que los verás. Guárdalos en un gestor de contraseñas o impresos.</p>
          <ol class="grid grid-cols-2 gap-x-4 gap-y-1 font-mono text-sm tracking-wider" data-cta-respaldo></ol>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="btn btn-secondary btn-sm" data-cta-respaldo-copiar><Icon name="copy" class="h-4 w-4" /> Copiar</button>
            <button type="button" class="btn btn-secondary btn-sm" data-cta-respaldo-bajar><Icon name="download" class="h-4 w-4" /> Descargar</button>
            <button type="button" class="btn btn-primary btn-sm" data-cta-respaldo-listo>Ya los guardé</button>
          </div>
        </div>

        <div data-tfa="activo" hidden class="mt-4 flex flex-col gap-4">
          <p class="text-sm"><span class="badge badge-accent">Activo</span> <span class="text-muted" data-cta-respaldo-restantes></span></p>
          <details class="rounded-2xl border border-line p-4">
            <summary class="cursor-pointer text-sm font-medium">Generar códigos de respaldo nuevos</summary>
            <form class="mt-3 flex flex-col gap-3" data-cta-form="tfa-respaldo" novalidate>
              <label class="block text-sm font-medium">
                Código de tu app (o un código de respaldo)
                <input type="text" name="codigo" class="field mt-1 tracking-widest" required autocomplete="one-time-code" maxlength="16" />
              </label>
              <button type="submit" class="btn btn-secondary justify-center">Generar</button>
              <p data-cta-error class="text-sm text-danger" aria-live="polite" hidden></p>
            </form>
          </details>
          <details class="rounded-2xl border border-line p-4">
            <summary class="cursor-pointer text-sm font-medium">Desactivar el doble factor</summary>
            <form class="mt-3 flex flex-col gap-3" data-cta-form="tfa-desactivar" novalidate>
              <label class="block text-sm font-medium" data-cta-clave-actual>
                Tu contraseña
                <input type="password" name="clave" class="field mt-1" autocomplete="current-password" maxlength="1024" />
              </label>
              <label class="block text-sm font-medium">
                Código de tu app (o un código de respaldo)
                <input type="text" name="codigo" class="field mt-1 tracking-widest" required autocomplete="one-time-code" maxlength="16" />
              </label>
              <button type="submit" class="btn btn-secondary justify-center">Desactivar</button>
              <p data-cta-error class="text-sm text-danger" aria-live="polite" hidden></p>
            </form>
          </details>
        </div>
      </section>

      <section class="card p-6" aria-labelledby="cta-github-titulo" data-cta-github-panel hidden>
        <h2 id="cta-github-titulo" class="text-lg font-semibold">GitHub</h2>
        <p class="mt-1 text-sm text-muted" data-cta-github-estado></p>
        <a href="/api/cuenta-github.php?vincular=1" class="btn btn-secondary mt-4" data-cta-github-vincular hidden><Icon name="github" class="h-4 w-4" /> Vincular GitHub</a>
        <details class="mt-4 rounded-2xl border border-line p-4" data-cta-github-desvincular hidden>
          <summary class="cursor-pointer text-sm font-medium">Desvincular GitHub</summary>
          <form class="mt-3 flex flex-col gap-3" data-cta-form="github-desvincular" novalidate>
            <label class="block text-sm font-medium" data-cta-clave-actual>
              Tu contraseña
              <input type="password" name="clave" class="field mt-1" autocomplete="current-password" maxlength="1024" />
            </label>
            <button type="submit" class="btn btn-secondary justify-center">Desvincular</button>
            <p data-cta-error class="text-sm text-danger" aria-live="polite" hidden></p>
          </form>
        </details>
      </section>

      <section class="card p-6 lg:col-span-2" aria-labelledby="cta-datos-titulo">
        <h2 id="cta-datos-titulo" class="text-lg font-semibold">Tus datos</h2>
        <p class="mt-1 text-sm text-muted">Puedes llevarte una copia de lo que guardamos o borrarlo todo. Consulta el <a href="/privacidad/" class="link">aviso de privacidad</a>.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <button type="button" class="btn btn-secondary btn-sm" data-cta-exportar><Icon name="download" class="h-4 w-4" /> Exportar mis datos</button>
        </div>
        <details class="mt-4 rounded-2xl border border-line p-4">
          <summary class="cursor-pointer text-sm font-medium text-danger">Borrar mi cuenta</summary>
          <form class="mt-3 flex max-w-md flex-col gap-3" data-cta-form="borrar" novalidate>
            <p class="text-sm text-muted">Se borra tu cuenta, tu contraseña, el vínculo con GitHub, el doble factor, tu progreso y tus favoritos del servidor. No se puede deshacer. Lo que tengas en este navegador no se toca. Tu suscripción al boletín es aparte.</p>
            <label class="block text-sm font-medium" data-cta-clave-actual>
              Tu contraseña
              <input type="password" name="clave" class="field mt-1" autocomplete="current-password" maxlength="1024" />
            </label>
            <label class="block text-sm font-medium" data-cta-borrar-codigo hidden>
              Código de tu app (o un código de respaldo)
              <input type="text" name="codigo" class="field mt-1 tracking-widest" autocomplete="one-time-code" maxlength="16" />
            </label>
            <label class="block text-sm font-medium" data-cta-borrar-correo hidden>
              Escribe tu correo para confirmar
              <input type="email" name="confirmar_correo" class="field mt-1" autocomplete="off" />
            </label>
            <label class="block text-sm font-medium">
              Escribe BORRAR para confirmar
              <input type="text" name="confirmacion" class="field mt-1" required autocomplete="off" autocapitalize="characters" />
            </label>
            <button type="submit" class="btn btn-secondary justify-center">Borrar mi cuenta para siempre</button>
            <p data-cta-error class="text-sm text-danger" aria-live="polite" hidden></p>
          </form>
        </details>
      </section>
    </div>

    <section data-vista="nodisponible" hidden class="card mt-8 max-w-md p-6">
      <h2 class="text-xl font-bold tracking-tight">Las cuentas no están disponibles</h2>
      <p class="mt-2 text-sm text-muted">Por ahora no podemos abrir cuentas. El resto de AyudaDev funciona igual y tu progreso y tus favoritos se guardan en este navegador.</p>
      <a href="/" class="btn btn-secondary mt-5">Volver al inicio</a>
    </section>

    <noscript><p class="card mt-6 p-6 text-sm">La cuenta necesita JavaScript activado. El resto del sitio funciona sin él y tu progreso se guarda en este navegador.</p></noscript>
  </div>
</BaseLayout>

<script>
  import { abrirSesion, cargarSesion, cerrarSesion, cuentasDisponibles, descartarSesionLocal, llamar, recargarSesion, sincronizar, usuarioActual, type Usuario } from '@/scripts/cuenta';
  import { aviso, conectarFormulario, conectarMostrarClave, mostrarVista, qs, valor } from '@/scripts/cuenta-ui';
  import { MENSAJES_OK, mensajeDeError } from '@/lib/cuenta';
  import { favoritos } from '@/scripts/favoritos';
  import { progreso } from '@/scripts/progreso';
  import { mostrarToast } from '@/scripts/toast';

  let reto = '';
  let codigosRespaldo: string[] = [];

  /* ---- mensajes que llegan por la dirección (retorno de GitHub) */
  const params = new URLSearchParams(location.search);
  const retoGitHub = /^#reto=([\w.-]+)$/.exec(location.hash)?.[1] ?? '';
  if (params.get('error')) aviso(mensajeDeError(params.get('error') ?? ''), 'error');
  else if (params.get('ok')) aviso(MENSAJES_OK[params.get('ok') ?? ''] ?? '', 'ok');
  if (params.has('error') || params.has('ok') || location.hash) history.replaceState(null, '', location.pathname);

  /* ---- panel */
  const pintarSync = () => {
    const p = progreso().length;
    const f = favoritos().length;
    const el = qs('[data-cta-sync]');
    if (el) el.textContent = `Tu progreso (${p}) y tus favoritos (${f}) se sincronizan con tu cuenta.`;
  };

  const pintarPanel = (u: Usuario) => {
    const saludo = qs('[data-cta-saludo]');
    if (saludo) saludo.textContent = u.nombre ? `Hola, ${u.nombre}` : 'Tu cuenta';
    const correo = qs('[data-cta-correo]');
    if (correo) correo.textContent = u.email;
    pintarSync();

    document.querySelectorAll<HTMLElement>('[data-cta-clave-actual]').forEach((el) => {
      el.hidden = !u.tiene_clave;
    });
    const estadoClave = qs('[data-cta-clave-estado]');
    if (estadoClave) estadoClave.textContent = u.tiene_clave ? 'Cámbiala cuando quieras. Al hacerlo se cierran tus otras sesiones.' : 'Entras con GitHub y no tienes contraseña. Crea una para poder entrar también con tu correo.';
    const botonClave = qs('[data-cta-clave-boton]');
    if (botonClave) botonClave.textContent = u.tiene_clave ? 'Cambiar contraseña' : 'Crear contraseña';

    const tfa = (nombre: string) => qs(`[data-tfa="${nombre}"]`);
    if (tfa('respaldo')?.hidden !== false && tfa('configurar')?.hidden !== false) {
      for (const n of ['apagado', 'configurar', 'activo']) {
        const el = tfa(n);
        if (el) el.hidden = n !== (u.totp ? 'activo' : 'apagado');
      }
    }
    const restantes = qs('[data-cta-respaldo-restantes]');
    if (restantes) restantes.textContent = `Te quedan ${u.respaldo} ${u.respaldo === 1 ? 'código de respaldo' : 'códigos de respaldo'}.`;

    const estadoGh = qs('[data-cta-github-estado]');
    const vincular = qs('[data-cta-github-vincular]');
    const desvincular = qs('[data-cta-github-desvincular]');
    if (estadoGh) estadoGh.textContent = u.github ? `Vinculado como ${u.github}. Puedes entrar con el botón de GitHub.` : 'Vincula GitHub para entrar sin escribir tu contraseña.';
    if (vincular) vincular.hidden = Boolean(u.github);
    if (desvincular) desvincular.hidden = !u.github || !u.tiene_clave;

    const pideCodigo = qs('[data-cta-borrar-codigo]');
    const pideCorreo = qs('[data-cta-borrar-correo]');
    if (pideCodigo) pideCodigo.hidden = u.tiene_clave || !u.totp;
    if (pideCorreo) pideCorreo.hidden = u.tiene_clave || u.totp;
  };

  const abrirPanel = async (): Promise<void> => {
    const u = usuarioActual() ?? (await cargarSesion());
    if (!u) return mostrarVista('entrar');
    pintarPanel(u);
    mostrarVista('panel');
  };

  const refrescarPanel = async (): Promise<void> => {
    // Pide el perfil de nuevo para reflejar lo que cambió.
    const abierta = await recargarSesion();
    if (abierta) pintarPanel(abierta);
    else mostrarVista('entrar');
  };

  /* ---- entrar */
  conectarFormulario(qs<HTMLFormElement>('[data-cta-form="entrar"]'), async (form) => {
    const r = await llamar('entrar', { email: valor(form, 'email'), clave: valor(form, 'clave') });
    if (!r.ok) return r;
    form.reset();
    if (r.code === 'totp') {
      reto = String(r.reto ?? '');
      mostrarVista('codigo');
      qs<HTMLInputElement>('[data-cta-form="codigo"] input[name="codigo"]')?.focus();
      return undefined;
    }
    await abrirSesion(String(r.csrf ?? ''));
    aviso(MENSAJES_OK.entrada ?? '', 'ok');
    await abrirPanel();
    return undefined;
  });

  conectarFormulario(qs<HTMLFormElement>('[data-cta-form="codigo"]'), async (form) => {
    const r = await llamar('entrar_2fa', { reto, codigo: valor(form, 'codigo') });
    if (!r.ok) {
      if (r.code === 'reto') {
        reto = '';
        mostrarVista('entrar');
        aviso(mensajeDeError('reto'), 'error');
        return undefined;
      }
      return r;
    }
    form.reset();
    reto = '';
    await abrirSesion(String(r.csrf ?? ''));
    aviso(MENSAJES_OK.entrada ?? '', 'ok');
    await abrirPanel();
    return undefined;
  });

  /* ---- contraseña */
  conectarFormulario(qs<HTMLFormElement>('[data-cta-form="clave"]'), async (form) => {
    const r = await llamar('clave_cambiar', { clave: valor(form, 'actual'), nueva: valor(form, 'nueva') });
    if (r.ok) {
      form.reset();
      mostrarToast('Contraseña actualizada');
      await refrescarPanel();
    }
    return r;
  });

  /* ---- doble factor */
  const mostrarTfa = (nombre: 'apagado' | 'configurar' | 'respaldo' | 'activo') => {
    document.querySelectorAll<HTMLElement>('[data-tfa]').forEach((el) => {
      el.hidden = el.dataset.tfa !== nombre;
    });
  };

  const pintarRespaldo = (codigos: string[]) => {
    codigosRespaldo = codigos;
    const lista = qs('[data-cta-respaldo]');
    if (lista) lista.innerHTML = codigos.map((c) => `<li>${c}</li>`).join('');
    mostrarTfa('respaldo');
    qs('[data-tfa="respaldo"] h3')?.setAttribute('tabindex', '-1');
    qs<HTMLElement>('[data-tfa="respaldo"] h3')?.focus();
  };

  conectarFormulario(qs<HTMLFormElement>('[data-cta-form="tfa-iniciar"]'), async (form) => {
    const r = await llamar('tfa_iniciar', { clave: valor(form, 'clave') });
    if (!r.ok) return r;
    form.reset();
    const uri = String(r.uri ?? '');
    const secreto = qs('[data-cta-secreto]');
    if (secreto) secreto.textContent = String(r.secreto ?? '').replace(/(.{4})/g, '$1 ').trim();
    const enlace = qs<HTMLAnchorElement>('[data-cta-otp-enlace]');
    if (enlace) enlace.href = uri;
    const contenedor = qs('[data-cta-qr]');
    if (contenedor) {
      const { default: qrcode } = await import('qrcode-generator');
      const qr = qrcode(0, 'M');
      qr.addData(uri);
      qr.make();
      contenedor.innerHTML = qr.createSvgTag({ cellSize: 4, margin: 4, scalable: true });
      const svg = contenedor.querySelector('svg');
      svg?.setAttribute('class', 'h-40 w-40');
      svg?.setAttribute('aria-hidden', 'true');
    }
    mostrarTfa('configurar');
    qs<HTMLInputElement>('[data-cta-form="tfa-activar"] input[name="codigo"]')?.focus();
    return undefined;
  });

  conectarFormulario(qs<HTMLFormElement>('[data-cta-form="tfa-activar"]'), async (form) => {
    const r = await llamar('tfa_activar', { codigo: valor(form, 'codigo') });
    if (!r.ok) return r;
    form.reset();
    pintarRespaldo(r.respaldo as string[]);
    return undefined;
  });

  conectarFormulario(qs<HTMLFormElement>('[data-cta-form="tfa-respaldo"]'), async (form) => {
    const r = await llamar('tfa_respaldo', { codigo: valor(form, 'codigo') });
    if (!r.ok) return r;
    form.reset();
    pintarRespaldo(r.respaldo as string[]);
    return undefined;
  });

  conectarFormulario(qs<HTMLFormElement>('[data-cta-form="tfa-desactivar"]'), async (form) => {
    const r = await llamar('tfa_desactivar', { clave: valor(form, 'clave'), codigo: valor(form, 'codigo') });
    if (!r.ok) return r;
    form.reset();
    mostrarToast('Doble factor desactivado');
    await refrescarPanel();
    return undefined;
  });

  qs('[data-cta-respaldo-listo]')?.addEventListener('click', async () => {
    codigosRespaldo = [];
    const lista = qs('[data-cta-respaldo]');
    if (lista) lista.innerHTML = '';
    mostrarTfa('activo');
    await refrescarPanel();
  });
  qs('[data-cta-respaldo-copiar]')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(codigosRespaldo.join('\n'));
      mostrarToast('Códigos copiados');
    } catch {
      mostrarToast('No se pudo copiar. Selecciónalos y cópialos a mano.', 'info');
    }
  });
  qs('[data-cta-respaldo-bajar]')?.addEventListener('click', () => {
    const blob = new Blob([`Códigos de respaldo de AyudaDev (cada uno sirve una vez)\n\n${codigosRespaldo.join('\n')}\n`], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'ayudadev-codigos-de-respaldo.txt';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  /* ---- GitHub */
  conectarFormulario(qs<HTMLFormElement>('[data-cta-form="github-desvincular"]'), async (form) => {
    const r = await llamar('github_desvincular', { clave: valor(form, 'clave') });
    if (!r.ok) return r;
    form.reset();
    mostrarToast('GitHub desvinculado');
    await refrescarPanel();
    return undefined;
  });

  /* ---- datos */
  qs('[data-cta-exportar]')?.addEventListener('click', async () => {
    try {
      const res = await fetch('/api/cuenta.php?a=exportar', { credentials: 'same-origin' });
      if (!res.ok) throw new Error('export');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(await res.blob());
      a.download = 'ayudadev-mi-cuenta.json';
      a.click();
      URL.revokeObjectURL(a.href);
    } catch {
      aviso(mensajeDeError('error'), 'error');
    }
  });

  conectarFormulario(qs<HTMLFormElement>('[data-cta-form="borrar"]'), async (form) => {
    const r = await llamar('borrar', {
      clave: valor(form, 'clave'),
      codigo: valor(form, 'codigo'),
      confirmar_correo: valor(form, 'confirmar_correo'),
      confirmacion: valor(form, 'confirmacion'),
    });
    if (!r.ok) return r;
    form.reset();
    descartarSesionLocal();
    mostrarVista('entrar');
    aviso('Tu cuenta se borró. Lo que tienes en este navegador sigue aquí.', 'ok');
    return undefined;
  });

  qs('[data-cta-salir]')?.addEventListener('click', async () => {
    const boton = qs<HTMLButtonElement>('[data-cta-salir]');
    if (boton) boton.disabled = true;
    const ok = await cerrarSesion();
    if (boton) boton.disabled = false;
    if (ok) {
      mostrarVista('entrar');
      aviso('Cerraste sesión. Tu progreso y tus favoritos siguen en tu cuenta.', 'ok');
    } else {
      aviso(mensajeDeError('error'), 'error');
    }
  });

  document.addEventListener('ayudadev:progreso-change', pintarSync);
  document.addEventListener('ayudadev:favoritos-change', pintarSync);

  /* ---- arranque */
  const iniciar = async () => {
    const { disponible, github } = await cuentasDisponibles();
    if (!disponible) return mostrarVista('nodisponible');
    if (github) {
      document.querySelectorAll<HTMLElement>('[data-cta-github]').forEach((el) => (el.hidden = false));
      const panelGh = qs('[data-cta-github-panel]');
      if (panelGh) panelGh.hidden = false;
    }
    if (retoGitHub) {
      reto = retoGitHub;
      mostrarVista('codigo');
      qs<HTMLInputElement>('[data-cta-form="codigo"] input[name="codigo"]')?.focus();
      return;
    }
    await abrirPanel();
    void sincronizar().then(pintarSync);
  };

  conectarMostrarClave();
  void iniciar();
</script>
