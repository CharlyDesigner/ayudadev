---
import ListadoLayout from '@layouts/ListadoLayout.astro';
import FiltroChips from '@components/ui/FiltroChips.astro';
import Icon from '@components/ui/Icon.astro';
import { COMUNIDAD, TIPOS_COMUNIDAD, ETIQUETAS_TIPO_COMUNIDAD } from '@data/comunidad';
import { temaPorSlug } from '@data/temas';

const tipos = TIPOS_COMUNIDAD.map((t) => ({ valor: t, etiqueta: ETIQUETAS_TIPO_COMUNIDAD[t], conteo: COMUNIDAD.filter((c) => c.tipo === t).length })).filter((t) => t.conteo > 0);
const ICONOS = { youtube: 'play', podcast: 'robot', newsletter: 'mail', comunidad: 'share', curso: 'school', evento: 'calendar', blog: 'newspaper' } as const;
const migas = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Comunidad', href: '/comunidad/' },
];
---

<ListadoLayout
  titulo="Comunidad y canales"
  descripcion="Canales, podcasts, newsletters, comunidades y plataformas gratuitas para seguir aprendiendo en español y conocer gente que programa."
  path="/comunidad/"
  eyebrow="No aprendas solo"
  migas={migas}
  total={COMUNIDAD.length}
  placeholder="Busca: YouTube, podcast, Discord, JavaScript..."
  unidad="enlaces"
>
  <Fragment slot="filtros">
    <FiltroChips grupo="tipo" etiqueta="Tipo" opciones={tipos} />
    <FiltroChips grupo="idioma" etiqueta="Idioma" opciones={[{ valor: 'es', etiqueta: 'Español' }, { valor: 'en', etiqueta: 'Inglés' }]} />
  </Fragment>

  {COMUNIDAD.length === 0 && <p class="card p-8 text-center text-muted">La lista está en camino.</p>}
  <div class="space-y-12">
    {tipos.map((t) => (
      <section data-chip-seccion aria-labelledby={`tipo-${t.valor}`}>
        <h2 id={`tipo-${t.valor}`} class="mb-4 text-xl font-semibold">{t.etiqueta}</h2>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {COMUNIDAD.filter((c) => c.tipo === t.valor)
            .sort((a, b) => Number(b.destacado) - Number(a.destacado) || a.nombre.localeCompare(b.nombre, 'es'))
            .map((c) => (
              <article class="card card-hover relative flex gap-4 p-5" data-item data-tipo={c.tipo} data-idioma={c.idioma} data-texto={`${c.nombre} ${c.descripcion} ${c.temas.join(' ')}`}>
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-surface-2 text-accent-ink" aria-hidden="true"><Icon name={ICONOS[c.tipo]} class="h-5 w-5" /></span>
                <div class="min-w-0">
                  <h3 class="font-semibold leading-snug"><a href={c.url} rel="noopener" target="_blank" class="after:absolute after:inset-0 after:rounded-[var(--radius-card)] hover:text-accent-ink">{c.nombre}</a></h3>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{c.descripcion}</p>
                  <p class="mt-3 flex flex-wrap gap-1.5">
                    {c.idioma === 'en' && <span class="badge">En inglés</span>}
                    {c.temas.slice(0, 3).map((s) => <span class="badge">{temaPorSlug(s)?.nombre ?? s}</span>)}
                  </p>
                </div>
              </article>
            ))}
        </div>
      </section>
    ))}
  </div>
</ListadoLayout>
