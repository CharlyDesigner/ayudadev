---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/ui/Icon.astro';
---

<BaseLayout title="Página no encontrada" description="Esta página no existe o cambió de lugar." path="/404/" noindex>
  <div class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-sm text-accent-ink">Error 404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">No encontramos esa página</h1>
    <p class="mt-3 max-w-md text-muted">Quizá el enlace cambió o nunca existió. Prueba con el buscador o vuelve al inicio.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      <a href="/" class="btn btn-primary"><Icon name="home" class="h-4 w-4" /> Ir al inicio</a>
      <button type="button" data-command-open class="btn btn-secondary"><Icon name="search" class="h-4 w-4" /> Buscar</button>
      <a href="/biblioteca/" class="btn btn-ghost">Ver la biblioteca</a>
    </div>
  </div>
</BaseLayout>
