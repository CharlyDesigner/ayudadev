---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/ui/Icon.astro';
---

<BaseLayout title="Revisa tu correo" description="Te enviamos un correo para confirmar tu suscripción." path="/newsletter/gracias/" noindex>
  <div class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="grid h-16 w-16 place-items-center rounded-full bg-accent text-on-accent"><Icon name="mail" class="h-8 w-8" /></span>
    <h1 class="mt-6 text-3xl font-bold tracking-tight">Ya casi. Revisa tu correo</h1>
    <p class="mt-3 max-w-md text-muted">Te enviamos un mensaje con un enlace para confirmar la suscripción. Si no lo ves en unos minutos, busca en la carpeta de spam o promociones.</p>
    <a href="/" class="btn btn-secondary mt-8">Volver al inicio</a>
  </div>
</BaseLayout>
