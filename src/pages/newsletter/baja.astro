---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { SITE } from '@data/site';
---

<BaseLayout title="Baja del boletín" description="Cómo darte de baja del boletín de AyudaDev." path="/newsletter/baja/" noindex>
  <div class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="grid h-16 w-16 place-items-center rounded-full bg-surface-2 text-accent-ink"><Icon name="x" class="h-8 w-8" /></span>

    <section data-estado="ok" hidden>
      <h1 class="mt-6 text-3xl font-bold tracking-tight">Te dimos de baja</h1>
      <p class="mx-auto mt-3 max-w-md text-muted">No volverás a recibir correos de AyudaDev. Puedes volver a suscribirte cuando quieras.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/newsletter/" class="btn btn-secondary">Volver a suscribirme</a>
        <a href="/" class="btn btn-primary">Ir al inicio</a>
      </div>
    </section>

    <section data-estado="enviado" hidden>
      <h1 class="mt-6 text-3xl font-bold tracking-tight">Revisa tu correo</h1>
      <p class="mx-auto mt-3 max-w-md text-muted">Si ese correo está en la lista, te enviamos un enlace para confirmar tu baja. Mira también en spam.</p>
      <a href="/" class="btn btn-secondary mt-8">Volver al inicio</a>
    </section>

    <section data-estado="formulario">
      <h1 class="mt-6 text-3xl font-bold tracking-tight">Darte de baja</h1>
      <p class="mx-auto mt-3 max-w-md text-muted">
        Cada correo del boletín trae un enlace "Darme de baja". Si no lo tienes a la mano, escribe tu correo y te enviamos uno nuevo.
      </p>

      <form action="/api/baja.php" method="post" class="mx-auto mt-6 flex w-full max-w-md flex-col gap-3 text-left">
        <div class="visually-hidden" aria-hidden="true">
          <label>No llenes este campo <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          <label>Tampoco este <input type="text" name="address_line_2" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label>
          <span class="visually-hidden">Tu correo electrónico</span>
          <input type="email" name="email" class="field" placeholder="tu@correo.com" required autocomplete="email" inputmode="email" />
        </label>
        <button type="submit" class="btn btn-primary justify-center">Enviarme el enlace de baja</button>
        <p data-baja-error class="text-sm text-danger" aria-live="polite" hidden></p>
      </form>

      <p class="mx-auto mt-6 max-w-md text-sm text-muted">
        ¿Prefieres que lo hagamos a mano? Escríbenos a <a href={`mailto:${SITE.contacto}`} class="link">{SITE.contacto}</a>.
      </p>
      <a href="/" class="btn btn-secondary mt-8">Volver al inicio</a>
    </section>
  </div>

  <script>
    const MENSAJES: Record<string, string> = {
      invalid: 'Ese correo no parece válido. Revísalo e inténtalo de nuevo.',
      rate_limit: 'Demasiados intentos. Espera unos minutos y vuelve a probar.',
      security: 'No pudimos validar el envío. Recarga la página e inténtalo otra vez.',
      error: 'Algo falló. Inténtalo de nuevo en un momento.',
    };
    const params = new URLSearchParams(location.search);
    const estado = params.has('ok') ? 'ok' : params.has('enviado') ? 'enviado' : 'formulario';
    document.querySelectorAll<HTMLElement>('[data-estado]').forEach((el) => {
      el.hidden = el.dataset.estado !== estado;
    });
    const error = params.get('error');
    const aviso = document.querySelector<HTMLElement>('[data-baja-error]');
    if (error && aviso) {
      aviso.hidden = false;
      aviso.textContent = MENSAJES[error] ?? MENSAJES.error;
    }
  </script>
</BaseLayout>
