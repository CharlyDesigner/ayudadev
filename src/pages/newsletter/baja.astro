---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { SITE } from '@data/site';
---

<BaseLayout title="Baja del boletín" description="Cómo darte de baja del boletín de AyudaDev." path="/newsletter/baja/" noindex>
  <div class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="grid h-16 w-16 place-items-center rounded-full bg-surface-2 text-accent-ink"><Icon name="x" class="h-8 w-8" /></span>
    <h1 class="mt-6 text-3xl font-bold tracking-tight" data-baja-ok hidden>Te dimos de baja</h1>
    <h1 class="mt-6 text-3xl font-bold tracking-tight" data-baja-info>Darte de baja</h1>
    <p class="mt-3 max-w-md text-muted" data-baja-ok hidden>No volverás a recibir correos de AyudaDev. Puedes volver cuando quieras.</p>
    <p class="mt-3 max-w-md text-muted" data-baja-info>Usa el enlace "darme de baja" que aparece al final de cualquier correo del boletín. Si lo perdiste, escríbenos a <a href={`mailto:${SITE.contacto}`} class="link">{SITE.contacto}</a> y lo hacemos a mano.</p>
    <a href="/" class="btn btn-secondary mt-8">Volver al inicio</a>
  </div>
  <script>
    if (new URLSearchParams(location.search).has('ok')) {
      document.querySelectorAll<HTMLElement>('[data-baja-ok]').forEach((el) => (el.hidden = false));
      document.querySelectorAll<HTMLElement>('[data-baja-info]').forEach((el) => (el.hidden = true));
    }
  </script>
</BaseLayout>
