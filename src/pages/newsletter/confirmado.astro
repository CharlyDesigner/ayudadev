---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/ui/Icon.astro';
---

<BaseLayout title="Suscripción confirmada" description="Ya estás en el boletín de AyudaDev." path="/newsletter/confirmado/" noindex>
  <div class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="grid h-16 w-16 place-items-center rounded-full bg-accent text-on-accent"><Icon name="check" class="h-8 w-8" /></span>
    <h1 class="mt-6 text-3xl font-bold tracking-tight">Listo, ya estás dentro</h1>
    <p class="mt-3 max-w-md text-muted">Gracias por confiar. Te escribiremos cuando haya guías o recursos nuevos. Mientras tanto, explora la biblioteca.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      <a href="/biblioteca/" class="btn btn-primary">Ir a la biblioteca</a>
      <a href="/guias/" class="btn btn-secondary">Ver las guías</a>
    </div>
  </div>
</BaseLayout>
