---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import PromptCard from '@components/ia/PromptCard.astro';
import { migasLd } from '@lib/seo';

const prompts = await getCollection('prompts');
const CATEGORIAS = [
  ['aprender', 'Aprender'],
  ['explicar', 'Explicar código'],
  ['depurar', 'Depurar'],
  ['refactorizar', 'Refactorizar'],
  ['escribir', 'Escribir código'],
  ['estudiar', 'Estudiar'],
  ['revisar', 'Revisar'],
  ['tests', 'Pruebas'],
  ['carrera', 'Carrera'],
  ['agentes', 'Agentes'],
] as const;
const titulo = 'Biblioteca de prompts';
const descripcion = 'Prompts probados para aprender, entender y depurar código con Claude, ChatGPT, Gemini o Copilot. Copia, cambia los marcadores entre corchetes y pega.';
const migas = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'IA', href: '/ia/' },
  { nombre: 'Prompts', href: '/ia/prompts/' },
];
---

<BaseLayout title={titulo} description={descripcion} path="/ia/prompts/" jsonLd={[migasLd(migas)]}>
  <div class="container-site py-10 sm:py-14">
    <Breadcrumbs migas={migas} class="mb-6" />
    <SectionHeader nivel="h1" eyebrow="IA" titulo={titulo} descripcion={descripcion} />

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría">
      <button type="button" class="chip" data-prompt-filter="" aria-pressed="true">Todos ({prompts.length})</button>
      {CATEGORIAS.map(([id, label]) => {
        const n = prompts.filter((p) => p.data.categoria === id).length;
        return n > 0 ? <button type="button" class="chip" data-prompt-filter={id} aria-pressed="false">{label} ({n})</button> : null;
      })}
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {prompts.map((p) => <PromptCard id={p.data.id} titulo={p.data.titulo} prompt={p.data.prompt} categoria={p.data.categoria} herramientas={p.data.herramientas} nota={p.data.nota} />)}
    </div>

    <p class="mt-10 text-sm text-muted">¿Tienes un prompt que te funciona? <a href="/enviar-recurso/" class="link">Compártelo</a> y lo agregamos con tu crédito.</p>
  </div>
</BaseLayout>

<script>
  const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-prompt-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-prompt]')];
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.promptFilter ?? '';
      botones.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cards.forEach((c) => (c.hidden = Boolean(f) && c.dataset.categoria !== f));
    })
  );
</script>
