---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Icon from '@components/ui/Icon.astro';
import { migasLd } from '@lib/seo';

const rutas = (await getCollection('rutas', (r) => !r.data.borrador)).sort((a, b) => a.data.orden - b.data.orden);
const datosRutas = rutas.map((r) => ({
  id: r.id,
  titulo: r.data.titulo,
  descripcion: r.data.descripcion,
  nivel: r.data.nivel,
  objetivo: r.data.objetivo,
  duracion: r.data.duracion,
  para: r.data.para,
  logos: r.data.logos.slice(0, 5),
  pasos: r.data.pasos.length,
  primero: { titulo: r.data.pasos[0]!.titulo, guia: r.data.pasos[0]!.guia ?? null },
}));

const titulo = 'Empieza aquí';
const descripcion = 'Responde tres preguntas y te recomendamos una ruta de estudio, tu primer paso para hoy y qué practicar. Sin registro y sin enviar nada: todo pasa en tu navegador.';
const migas = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Empieza aquí', href: '/empieza-aqui/' },
];

const preguntas = [
  {
    id: 'objetivo',
    titulo: '¿Qué te gustaría crear?',
    opciones: [
      ['web', 'Sitios y apps web', 'Páginas, tiendas, plataformas y APIs', 'world'],
      ['movil', 'Apps para el celular', 'Android, iPhone o ambos', 'device-mobile'],
      ['datos-ia', 'Datos e inteligencia artificial', 'Análisis, automatización y modelos', 'sparkles'],
      ['juegos', 'Videojuegos', 'Desde juegos sencillos hasta 3D', 'trophy'],
      ['sistemas', 'Sistemas y programas rápidos', 'Terminal, rendimiento, hardware', 'cpu'],
      ['general', 'Aún no lo sé', 'Quiero probar y descubrir', 'compass'],
    ],
  },
  {
    id: 'experiencia',
    titulo: '¿Cuánta experiencia tienes?',
    opciones: [
      ['ninguna', 'Nunca he programado', 'Empiezo desde cero', 'flag'],
      ['algo', 'Sé algo', 'He hecho cursos o scripts sencillos', 'code'],
      ['trabajo', 'Ya trabajo con código', 'Quiero ampliar o cambiar de área', 'rocket'],
    ],
  },
  {
    id: 'tiempo',
    titulo: '¿Cuánto tiempo puedes dedicar por semana?',
    opciones: [
      ['poco', '2 a 4 horas', 'Un ritmo tranquilo', 'clock'],
      ['medio', '5 a 8 horas', 'Constante y realista', 'calendar'],
      ['mucho', '9 horas o más', 'Quiero avanzar rápido', 'trophy'],
    ],
  },
] as const;
---

<BaseLayout title={titulo} description={descripcion} path="/empieza-aqui/" image="/og/guias.png" jsonLd={[migasLd(migas)]}>
  <div class="container-site py-10 sm:py-14">
    <Breadcrumbs migas={migas} class="mb-6" />
    <SectionHeader nivel="h1" eyebrow="Dos minutos" titulo="Encuentra tu ruta" descripcion={descripcion} />

    {rutas.length === 0 && <p class="card mt-10 p-8 text-center text-muted">Las rutas están en camino. Mientras tanto explora la <a href="/biblioteca/" class="link">biblioteca</a> y las <a href="/guias/" class="link">guías</a>.</p>}

    {rutas.length > 0 && (
      <>
        <form id="quiz" class="mt-10 max-w-4xl space-y-10" novalidate>
          {preguntas.map((p, i) => (
            <fieldset class="min-w-0">
              <legend class="mb-4 flex items-center gap-3 text-xl font-bold tracking-tight">
                <span class="grid h-8 w-8 place-items-center rounded-full bg-accent text-sm text-on-accent" aria-hidden="true">{i + 1}</span>
                {p.titulo}
              </legend>
              <div class:list={['grid gap-3', p.opciones.length > 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-3']}>
                {p.opciones.map(([valor, etiqueta, ayuda, icono]) => (
                  <label class="card card-hover relative flex cursor-pointer items-start gap-3 p-4 has-checked:border-accent has-checked:bg-accent/10 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent-ink">
                    <input type="radio" name={p.id} value={valor} class="peer visually-hidden" required />
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-surface-2 text-accent-ink peer-checked:bg-accent peer-checked:text-on-accent"><Icon name={icono as any} class="h-5 w-5" /></span>
                    <span class="min-w-0">
                      <span class="block font-semibold leading-snug">{etiqueta}</span>
                      <span class="block text-sm text-muted">{ayuda}</span>
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}

          <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class="btn btn-primary">Ver mi ruta <Icon name="arrow-right" class="h-4 w-4" /></button>
            <button type="reset" class="btn btn-ghost" id="quiz-reset">Empezar de nuevo</button>
            <p id="quiz-aviso" class="text-sm text-danger" role="alert" hidden>Responde las tres preguntas para ver tu ruta.</p>
          </div>
        </form>

        <section id="resultado" class="mt-14 max-w-4xl scroll-mt-24" aria-live="polite" hidden>
          <p class="eyebrow">Tu recomendación</p>
          <div id="resultado-principal" class="mt-4"></div>
          <h2 class="mt-10 text-lg font-semibold">Otras rutas que podrían gustarte</h2>
          <div id="resultado-otras" class="mt-4 grid gap-3 sm:grid-cols-2"></div>
          <div class="mt-10 card flex flex-wrap items-center justify-between gap-4 p-5">
            <p class="text-sm"><strong>Tip:</strong> usa la <a href="/ia/aprende/aprender-sin-copiar/" class="link">IA como tutor</a>, no como atajo. Te explicamos cómo.</p>
            <a href="/rutas/" class="btn btn-secondary btn-sm">Ver todas las rutas</a>
          </div>
        </section>

        <script type="application/json" id="datos-rutas" set:html={JSON.stringify(datosRutas)} />
      </>
    )}
  </div>
</BaseLayout>

<script>
  interface Ruta { id: string; titulo: string; descripcion: string; nivel: string; objetivo: string; duracion: string; para: string; logos: string[]; pasos: number; primero: { titulo: string; guia: string | null } }

  const datos = document.getElementById('datos-rutas');
  const form = document.getElementById('quiz') as HTMLFormElement | null;
  if (datos && form) {
    const rutas: Ruta[] = JSON.parse(datos.textContent ?? '[]');
    const resultado = document.getElementById('resultado') as HTMLElement;
    const principal = document.getElementById('resultado-principal') as HTMLElement;
    const otras = document.getElementById('resultado-otras') as HTMLElement;
    const aviso = document.getElementById('quiz-aviso') as HTMLElement;
    const NIVEL: Record<string, string> = { principiante: 'Principiante', intermedio: 'Intermedio', avanzado: 'Avanzado' };
    const OBJ: Record<string, string> = { web: 'Desarrollo web', movil: 'Apps móviles', 'datos-ia': 'Datos e IA', sistemas: 'Sistemas', juegos: 'Videojuegos', general: 'Primeros pasos' };
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);

    const puntuar = (r: Ruta, objetivo: string, exp: string): number => {
      let s = 0;
      if (r.objetivo === objetivo) s += 10;
      else if (r.objetivo === 'general') s += 3;
      const ideal = exp === 'ninguna' ? 'principiante' : exp === 'algo' ? 'intermedio' : 'avanzado';
      if (r.nivel === ideal) s += 5;
      else if (exp === 'algo' && r.nivel === 'principiante') s += 3;
      else if (exp === 'trabajo' && r.nivel === 'intermedio') s += 3;
      else if (exp === 'ninguna' && r.nivel === 'intermedio') s -= 4;
      else if (exp !== 'ninguna' && r.nivel === 'principiante') s -= 1;
      return s;
    };
    const logos = (r: Ruta) => r.logos.map((l) => `<li class="logo-tile grid h-10 w-10 place-items-center rounded-xl p-2"><img src="/logos/${esc(l)}.svg" alt="${esc(l)}" width="28" height="28" class="h-full w-full object-contain" /></li>`).join('');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const objetivo = String(f.get('objetivo') ?? '');
      const exp = String(f.get('experiencia') ?? '');
      const tiempo = String(f.get('tiempo') ?? '');
      if (!objetivo || !exp || !tiempo) { aviso.hidden = false; return; }
      aviso.hidden = true;

      const orden = [...rutas].sort((a, b) => puntuar(b, objetivo, exp) - puntuar(a, objetivo, exp));
      const [mejor, ...resto] = orden;
      if (!mejor) return;
      const consejo = tiempo === 'poco' ? 'Con un ritmo tranquilo, avanza un paso a la vez y celebra cada uno.' : tiempo === 'medio' ? 'Con ese ritmo avanzarás de forma constante. Planea sesiones fijas en la semana.' : 'Con ese tiempo avanzarás rápido. Cuida descansar y practicar mucho, no solo leer.';

      principal.innerHTML = `<article class="card relative overflow-hidden bg-glow p-6 sm:p-8">
        <ul class="mb-4 flex gap-2" aria-label="Tecnologías de la ruta">${logos(mejor)}</ul>
        <div class="flex flex-wrap gap-1.5"><span class="badge badge-accent">${esc(OBJ[mejor.objetivo] ?? mejor.objetivo)}</span><span class="badge">${esc(NIVEL[mejor.nivel] ?? mejor.nivel)}</span><span class="badge">${esc(mejor.duracion)}</span><span class="badge">${mejor.pasos} pasos</span></div>
        <h3 class="mt-3 text-2xl font-bold tracking-tight">${esc(mejor.titulo)}</h3>
        <p class="mt-2 text-muted">${esc(mejor.descripcion)}</p>
        <p class="mt-3 text-sm"><span class="font-medium">Es para ti si:</span> <span class="text-muted">${esc(mejor.para)}</span></p>
        <div class="mt-5 rounded-2xl bg-surface-2 p-4 text-sm"><p class="font-semibold">Tu primer paso para hoy</p><p class="mt-1 text-muted">${esc(mejor.primero.titulo)}. ${esc(consejo)}</p></div>
        <div class="mt-6 flex flex-wrap gap-2"><a class="btn btn-primary" href="/rutas/${esc(mejor.id)}/">Empezar esta ruta</a>${mejor.primero.guia ? `<a class="btn btn-secondary" href="/guias/${esc(mejor.primero.guia)}/">Leer la primera guía</a>` : ''}</div>
      </article>`;
      otras.innerHTML = resto.slice(0, 4).map((r) => `<a class="card card-hover p-4" href="/rutas/${esc(r.id)}/"><span class="badge">${esc(OBJ[r.objetivo] ?? r.objetivo)}</span><span class="mt-2 block font-semibold">${esc(r.titulo)}</span><span class="mt-1 block text-sm text-muted">${esc(r.duracion)} · ${r.pasos} pasos</span></a>`).join('');

      resultado.hidden = false;
      resultado.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });
    form.addEventListener('reset', () => { resultado.hidden = true; aviso.hidden = true; });
    form.addEventListener('change', () => { aviso.hidden = true; });
  }
</script>
