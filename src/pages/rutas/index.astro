---
import { getCollection } from 'astro:content';
import ListadoLayout from '@layouts/ListadoLayout.astro';
import FiltroChips from '@components/ui/FiltroChips.astro';
import Icon from '@components/ui/Icon.astro';
import { ETIQUETAS_NIVEL } from '@lib/schemas';

const OBJETIVOS: Record<string, string> = {
  web: 'Desarrollo web',
  movil: 'Apps móviles',
  'datos-ia': 'Datos e IA',
  sistemas: 'Sistemas',
  juegos: 'Videojuegos',
  general: 'Primeros pasos',
};
const lista = (await getCollection('rutas', (e) => !e.data.borrador)).sort((a, b) => a.data.orden - b.data.orden || a.data.titulo.localeCompare(b.data.titulo, 'es'));
const objetivos = Object.keys(OBJETIVOS)
  .map((o) => ({ valor: o, etiqueta: OBJETIVOS[o]!, conteo: lista.filter((r) => r.data.objetivo === o).length }))
  .filter((o) => o.conteo > 0);
const migas = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Rutas de estudio', href: '/rutas/' },
];
---

<ListadoLayout
  titulo="Rutas de estudio"
  descripcion="Caminos ordenados paso a paso, desde el primer día hasta tu primer proyecto. Cada paso te dice qué guía leer, qué recursos usar, qué practicar y qué deberías poder hacer al terminar."
  path="/rutas/"
  eyebrow="Aprende con un plan"
  migas={migas}
  total={lista.length}
  placeholder="Busca una ruta: web, Python, datos, móvil..."
  unidad="rutas"
  enlace={{ href: '/empieza-aqui/', label: 'No sé cuál elegir' }}
>
  <Fragment slot="filtros">
    <FiltroChips grupo="objetivo" etiqueta="Objetivo" opciones={objetivos} />
    <FiltroChips grupo="nivel" etiqueta="Nivel" opciones={['principiante', 'intermedio', 'avanzado'].map((n) => ({ valor: n, etiqueta: ETIQUETAS_NIVEL[n as keyof typeof ETIQUETAS_NIVEL] }))} />
  </Fragment>

  {lista.length === 0 && <p class="card p-8 text-center text-muted">Las primeras rutas están en camino.</p>}
  <div class="grid gap-5 md:grid-cols-2">
    {lista.map((r) => (
      <article class="card card-hover group relative flex flex-col gap-4 p-6" data-item data-objetivo={r.data.objetivo} data-nivel={r.data.nivel} data-texto={`${r.data.titulo} ${r.data.descripcion} ${r.data.para}`}>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="flex flex-wrap gap-1.5">
            <span class="badge badge-accent">{OBJETIVOS[r.data.objetivo]}</span>
            <span class="badge">{ETIQUETAS_NIVEL[r.data.nivel]}</span>
          </div>
          <ul class="flex -space-x-1.5" aria-label="Tecnologías de la ruta">
            {r.data.logos.slice(0, 5).map((l) => (
              <li class="logo-tile grid h-9 w-9 place-items-center rounded-xl p-1.5 ring-2 ring-[var(--ad-surface)]"><img src={`/logos/${l}.svg`} alt={l} width="24" height="24" loading="lazy" decoding="async" class="h-full w-full object-contain" /></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold leading-snug"><a href={`/rutas/${r.id}/`} class="after:absolute after:inset-0 after:rounded-[var(--radius-card)] hover:text-accent-ink">{r.data.titulo}</a></h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{r.data.descripcion}</p>
          <p class="mt-3 text-sm"><span class="font-medium">Para ti si:</span> <span class="text-muted">{r.data.para}</span></p>
        </div>
        <div class="mt-auto space-y-3">
          <div class="progress-track" role="progressbar" aria-label="Tu progreso en la ruta" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-prog-ruta={r.id} data-prog-total={r.data.pasos.length}>
            <div class="progress-fill" data-prog-fill></div>
            <span class="visually-hidden" data-prog-text></span>
          </div>
          <div class="flex items-center justify-between text-xs text-muted">
            <span class="inline-flex items-center gap-1"><Icon name="clock" class="h-3.5 w-3.5" /> {r.data.duracion}</span>
            <span>{r.data.pasos.length} pasos</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</ListadoLayout>

