---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { temaPorSlug } from '@data/temas';
import { ETIQUETAS_NIVEL } from '@lib/schemas';
import { SITE } from '@data/site';

export async function getStaticPaths() {
  const lista = (await getCollection('proyectos', (e) => !e.data.borrador)).sort((a, b) => a.data.orden - b.data.orden || a.data.titulo.localeCompare(b.data.titulo, 'es'));
  return lista.map((e, i) => ({ params: { slug: e.id }, props: { e, anterior: lista[i - 1] ?? null, siguiente: lista[i + 1] ?? null } }));
}

const { e, anterior, siguiente } = Astro.props;
const { Content, headings } = await render(e);
const path = `/proyectos/${e.id}/`;
const migas = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Proyectos', href: '/proyectos/' },
  { nombre: e.data.titulo, href: path },
];
const temas = e.data.temas.map((s) => temaPorSlug(s)).filter((t) => t !== undefined);
---

<ArticleLayout
  titulo={e.data.titulo}
  descripcion={e.data.descripcion}
  path={path}
  eyebrow="Proyecto para practicar"
  migas={migas}
  headings={headings}
  publicado={e.data.publicado}
  actualizado={e.data.actualizado}
  meta={[
    { icono: 'school', texto: ETIQUETAS_NIVEL[e.data.nivel] },
    { icono: 'clock', texto: e.data.tiempo },
  ]}
  progId={`proyecto:${e.id}`}
  sinNewsletter
  anterior={anterior ? { titulo: anterior.data.titulo, href: `/proyectos/${anterior.id}/` } : undefined}
  siguiente={siguiente ? { titulo: siguiente.data.titulo, href: `/proyectos/${siguiente.id}/` } : undefined}
  editarUrl={`${SITE.repo}/edit/main/src/content/proyectos/${e.id}.mdx`}
>
  <div class="not-prose mb-8 grid gap-4 rounded-[var(--radius-card)] border border-line bg-surface p-5 sm:grid-cols-2">
    {e.data.tecnologias.length > 0 && (
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">Tecnologías</p>
        <ul class="flex flex-wrap gap-2">
          {e.data.tecnologias.map((l) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-line bg-surface-2 py-1 pr-3 pl-1 text-sm">
              <span class="logo-tile grid h-6 w-6 place-items-center rounded-full p-1"><img src={`/logos/${l}.svg`} alt="" width="16" height="16" class="h-full w-full object-contain" /></span>
              {l}
            </li>
          ))}
        </ul>
      </div>
    )}
    {e.data.habilidades.length > 0 && (
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">Practicas</p>
        <ul class="flex flex-wrap gap-1.5">{e.data.habilidades.map((h) => <li class="badge">{h}</li>)}</ul>
      </div>
    )}
  </div>
  <Content />
  {temas.length > 0 && (
    <section class="not-prose mt-10">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-muted">Recursos para este proyecto</h2>
      <div class="flex flex-wrap gap-2">
        {temas.map((t) => <a href={`/biblioteca/${t!.slug}/`} class="chip">{t!.nombre}</a>)}
      </div>
    </section>
  )}
</ArticleLayout>
