---
import Icon from '@components/ui/Icon.astro';
interface Props {
  tipo?: 'info' | 'tip' | 'warning';
  titulo?: string;
}
const { tipo = 'info', titulo } = Astro.props;
const icono = { info: 'info-circle', tip: 'bulb', warning: 'alert-triangle' } as const;
const etiqueta = { info: 'Nota', tip: 'Consejo', warning: 'Cuidado' } as const;
---

<aside class:list={['not-prose my-6 flex gap-3 rounded-2xl border p-4 text-[0.95rem] leading-relaxed', tipo === 'warning' ? 'border-danger/40 bg-danger/5' : 'border-line bg-surface']} role="note">
  <Icon name={icono[tipo]} class:list={['mt-0.5 h-5 w-5 shrink-0', tipo === 'warning' ? 'text-danger' : 'text-accent-ink']} />
  <div class="min-w-0 [&_code]:rounded-md [&_code]:border [&_code]:border-line [&_code]:bg-surface-2 [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.85em] [&_p+p]:mt-2 [&_a]:underline">
    <p class="mb-1 font-semibold">{titulo ?? etiqueta[tipo]}</p>
    <slot />
  </div>
</aside>
