---
/** Barra fina de progreso de lectura en la parte superior (solo mejora, no es necesaria). */
---

<div class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-0.5 bg-transparent" aria-hidden="true">
  <div data-lectura class="h-full w-0 bg-accent transition-[width] duration-100"></div>
</div>

<script>
  const barra = document.querySelector<HTMLElement>('[data-lectura]');
  const articulo = document.querySelector<HTMLElement>('article.prose');
  if (barra && articulo) {
    const actualizar = () => {
      const r = articulo.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const avance = Math.min(1, Math.max(0, (-r.top + 80) / Math.max(total, 1)));
      barra.style.width = `${Math.round(avance * 100)}%`;
    };
    window.addEventListener('scroll', actualizar, { passive: true });
    window.addEventListener('resize', actualizar);
    actualizar();
  }
</script>
