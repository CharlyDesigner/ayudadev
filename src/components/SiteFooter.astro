---
import Logo from '@components/Logo.astro';
import Icon from '@components/ui/Icon.astro';
import { NAV, FOOTER_LINKS, SITE } from '@data/site';

const anio = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="container-site grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div class="max-w-sm">
      <Logo />
      <p class="mt-4 text-sm leading-relaxed text-muted">{SITE.lema} Recursos curados, guías con ejemplos y un apartado de IA para la comunidad hispanohablante.</p>
      <div class="mt-5 flex gap-2">
        {SITE.redes.map((r) => (
          <a href={r.url} rel="noopener" target="_blank" class="chip">{r.nombre}</a>
        ))}
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold">Explora</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {NAV.map((n) => (
          <li><a href={n.href} class="hover:text-fg">{n.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold">Proyecto</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {FOOTER_LINKS.map((n) => (
          <li><a href={n.href} class="hover:text-fg">{n.label}</a></li>
        ))}
        <li>
          <a href={SITE.repo} rel="noopener" target="_blank" class="inline-flex items-center gap-1 hover:text-fg">
            Código en GitHub <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold">Apoya</h2>
      <p class="mt-3 text-sm text-muted">Este sitio es gratis y sin anuncios. Si te sirve, puedes invitar un café o compartirlo.</p>
      <a href="/apoya/" class="btn btn-primary btn-sm mt-4">
        <Icon name="heart" class="h-4 w-4" /> Apoyar el proyecto
      </a>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-site flex flex-col gap-3 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {anio} {SITE.nombre}. Un proyecto de
        <a href={SITE.autor.url} class="hover:text-fg" rel="noopener" target="_blank">{SITE.autor.nombre}</a> ·
        <a href={SITE.organizacion.url} class="hover:text-fg" rel="noopener" target="_blank">{SITE.organizacion.nombre}</a>.
      </p>
      <p>
        Inspirado en <a href={SITE.inspiracion.url} class="hover:text-fg" rel="noopener" target="_blank">{SITE.inspiracion.nombre}</a>. Cada recurso enlaza a su fuente original.
      </p>
    </div>
  </div>
</footer>
