---
import Logo from '@components/Logo.astro';
import Icon from '@components/ui/Icon.astro';
import { FOOTER_LINKS, SITE } from '@data/site';

const anio = new Date().getFullYear();
const columnas = [
  {
    titulo: 'Aprende',
    enlaces: [
      ['Empieza aquí', '/empieza-aqui/'],
      ['Rutas de estudio', '/rutas/'],
      ['Guías con ejemplos', '/guias/'],
      ['Biblioteca gratis', '/biblioteca/'],
      ['Fundamentos', '/fundamentos/'],
    ],
  },
  {
    titulo: 'Practica',
    enlaces: [
      ['Retos', '/retos/'],
      ['Proyectos', '/proyectos/'],
      ['Hojas de referencia', '/hojas/'],
      ['Glosario', '/glosario/'],
      ['Mi progreso', '/progreso/'],
      ['Mi cuenta', '/cuenta/'],
    ],
  },
  {
    titulo: 'IA y carrera',
    enlaces: [
      ['Herramientas de IA', '/ia/'],
      ['Prompts', '/ia/prompts/'],
      ['Aprende con IA', '/ia/aprende/'],
      ['Carrera', '/carrera/'],
      ['Herramientas', '/herramientas/'],
      ['Comunidad', '/comunidad/'],
    ],
  },
];
---

<footer class="mt-24 border-t border-line">
  <div class="container-site grid gap-10 py-14 md:grid-cols-[1.5fr_repeat(3,1fr)_1fr]">
    <div class="max-w-sm">
      <Logo />
      <p class="mt-4 text-sm leading-relaxed text-muted">{SITE.lema} Recursos curados, guías con ejemplos y un apartado de IA para la comunidad hispanohablante.</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {SITE.redes.map((r) => <a href={r.url} rel="noopener" target="_blank" class="chip">{r.nombre}</a>)}
      </div>
    </div>

    {columnas.map((c) => (
      <nav aria-label={c.titulo}>
        <h2 class="text-sm font-semibold">{c.titulo}</h2>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          {c.enlaces.map(([l, h]) => <li><a href={h} class="hover:text-fg">{l}</a></li>)}
        </ul>
      </nav>
    ))}

    <nav aria-label="Proyecto">
      <h2 class="text-sm font-semibold">Proyecto</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {FOOTER_LINKS.map((n) => <li><a href={n.href} class="hover:text-fg">{n.label}</a></li>)}
        <li>
          <a href={SITE.repo} rel="noopener" target="_blank" class="inline-flex items-center gap-1 hover:text-fg">Código en GitHub <Icon name="arrow-up-right" class="h-3.5 w-3.5" /></a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-line">
    <div class="container-site flex flex-col gap-3 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {anio} {SITE.nombre}. Un proyecto de
        <a href={SITE.autor.url} class="hover:text-fg" rel="noopener" target="_blank">{SITE.autor.nombre}</a> ·
        <a href={SITE.organizacion.url} class="hover:text-fg" rel="noopener" target="_blank">{SITE.organizacion.nombre}</a>.
      </p>
      <p>
        Inspirado en <a href={SITE.inspiracion.url} class="hover:text-fg" rel="noopener" target="_blank">{SITE.inspiracion.nombre}</a>. Los logos pertenecen a sus respectivos dueños y se usan solo para identificar cada tecnología.
      </p>
    </div>
  </div>
</footer>
