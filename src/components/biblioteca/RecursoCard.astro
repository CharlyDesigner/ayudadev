---
import Icon from '@components/ui/Icon.astro';
import FavoriteButton from '@components/biblioteca/FavoriteButton.astro';
import { ETIQUETAS_FORMATO, ETIQUETAS_LICENCIA, ETIQUETAS_NIVEL, ETIQUETAS_TIPO, type Recurso } from '@lib/schemas';
import { temaPorSlug } from '@data/temas';

interface Props {
  recurso: Recurso;
  mostrarTema?: boolean;
}
const { recurso: r, mostrarTema = false } = Astro.props;
const tema = temaPorSlug(r.tema);
const host = new URL(r.url).hostname.replace(/^www\./, '');
---

<article
  id={r.id}
  class="card card-hover relative flex flex-col gap-3 p-5"
  data-recurso
  data-tema={r.tema}
  data-area={tema?.area}
  data-tipo={r.tipo}
  data-nivel={r.nivel}
  data-formato={r.formato}
  data-idioma={r.idioma}
  data-texto={`${r.titulo} ${r.autor} ${r.descripcion} ${r.etiquetas.join(' ')} ${tema?.nombre ?? ''}`}
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex flex-wrap gap-1.5">
      <span class="badge badge-accent">{ETIQUETAS_TIPO[r.tipo]}</span>
      <span class="badge">{ETIQUETAS_NIVEL[r.nivel]}</span>
      {r.idioma === 'en' && <span class="badge">En inglés</span>}
      {mostrarTema && tema && <span class="badge">{tema.nombre}</span>}
    </div>
    <FavoriteButton id={r.id} />
  </div>

  <h3 class="text-lg font-semibold leading-snug">
    <a href={r.url} rel="noopener" target="_blank" class="after:absolute after:inset-0 after:rounded-[var(--radius-card)] hover:text-accent-ink">
      {r.titulo}
    </a>
  </h3>
  <p class="text-sm text-muted">{r.autor}</p>
  <p class="text-sm leading-relaxed text-pretty">{r.descripcion}</p>

  <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-2 text-xs text-muted">
    <span class="inline-flex items-center gap-1.5">
      <span class="font-medium text-fg">{ETIQUETAS_FORMATO[r.formato]}</span>
      <span aria-hidden="true">·</span>
      <span title="Licencia del recurso">{ETIQUETAS_LICENCIA[r.licencia]}</span>
    </span>
    <span class="relative z-10 inline-flex items-center gap-1" title={`Abre ${host} en otra pestaña`}>
      {host} <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
    </span>
  </div>
</article>
