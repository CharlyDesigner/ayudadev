---
interface Props {
  class?: string;
  conTexto?: boolean;
}
const { class: className = '', conTexto = true } = Astro.props;
---

<a href="/" class:list={['inline-flex items-center gap-2.5 font-semibold tracking-tight', className]} aria-label="AyudaDev, inicio">
  <span class="grid h-8 w-8 place-items-center rounded-[10px] bg-accent text-on-accent" aria-hidden="true">
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14" />
    </svg>
  </span>
  {conTexto && (
    <span class="text-[1.05rem]">
      Ayuda<span class="text-accent-ink">Dev</span>
    </span>
  )}
</a>
