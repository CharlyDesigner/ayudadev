---
import Logo from '@components/Logo.astro';
import ThemeToggle from '@components/nav/ThemeToggle.astro';
import Icon from '@components/ui/Icon.astro';
import { NAV, SITE } from '@data/site';

const actual = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
const grupoActivo = (n: (typeof NAV)[number]) => Boolean(n.hijos?.some((h) => activo(h.href)));
---

<header class="sticky top-0 z-40 border-b border-line glass">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <Logo />

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-0.5">
        {NAV.map((item) =>
          item.hijos ? (
            <li class="relative" data-menu>
              <button
                type="button"
                data-menu-btn
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="menu-referencia"
                class:list={[
                  'inline-flex items-center gap-1 rounded-full px-3.5 py-2 text-sm font-medium transition-colors hover:bg-surface hover:text-fg',
                  grupoActivo(item) ? 'bg-surface text-fg' : 'text-muted',
                ]}
              >
                {item.label}
                <Icon name="chevron-down" class="h-3.5 w-3.5 transition-transform [[aria-expanded=true]>&]:rotate-180" />
              </button>
              <div id="menu-referencia" data-menu-panel hidden class="absolute top-full left-1/2 z-50 mt-2 w-[34rem] -translate-x-1/2 rounded-3xl border border-line bg-surface p-3 shadow-2xl">
                <ul class="grid grid-cols-2 gap-1">
                  {item.hijos.map((h) => (
                    <li>
                      <a
                        href={h.href}
                        aria-current={activo(h.href) ? 'page' : undefined}
                        class="flex items-start gap-3 rounded-2xl p-3 transition-colors hover:bg-surface-2 aria-[current=page]:bg-surface-2"
                      >
                        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-surface-2 text-accent-ink"><Icon name={(h.icono ?? 'book') as any} class="h-[1.15rem] w-[1.15rem]" /></span>
                        <span class="min-w-0">
                          <span class="block text-sm font-semibold">{h.label}</span>
                          <span class="block text-xs leading-snug text-muted">{h.descripcion}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a href="/explorar/" class="mt-2 flex items-center justify-between rounded-2xl border border-line px-4 py-2.5 text-sm font-medium text-muted transition-colors hover:text-fg">
                  Ver todo el sitio <Icon name="arrow-right" class="h-4 w-4" />
                </a>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={activo(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-3.5 py-2 text-sm font-medium transition-colors hover:bg-surface hover:text-fg',
                  activo(item.href) ? 'bg-surface text-fg' : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-command-open
        class="hidden items-center gap-2 rounded-full border border-line bg-surface px-3 py-2 text-sm text-muted transition-colors hover:text-fg sm:inline-flex"
        aria-label="Buscar en el sitio"
      >
        <Icon name="search" class="h-4 w-4" />
        <span class="hidden xl:inline">Buscar</span>
        <kbd class="hidden xl:inline">Ctrl K</kbd>
      </button>
      <button type="button" data-command-open class="grid h-10 w-10 place-items-center rounded-full text-muted hover:bg-surface hover:text-fg sm:hidden" aria-label="Buscar">
        <Icon name="search" />
      </button>
      <a
        href="/progreso/"
        class="hidden h-10 w-10 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-fg lg:grid"
        aria-label="Mi progreso"
        title="Mi progreso"
      >
        <Icon name="trophy" />
      </a>
      <a
        href="/biblioteca/favoritos/"
        class="relative grid h-10 w-10 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-fg"
        aria-label="Tus favoritos"
        title="Favoritos"
      >
        <Icon name="heart" />
        <span data-fav-count hidden class="absolute -top-0.5 -right-0.5 min-w-4 rounded-full bg-accent px-1 text-center text-[10px] font-bold leading-4 text-on-accent">0</span>
      </a>
      <ThemeToggle />
      <a href="/empieza-aqui/" class="btn btn-primary btn-sm ml-1 hidden lg:inline-flex">
        <Icon name="compass" class="h-4 w-4" /> Empieza aquí
      </a>
    </div>
  </div>
</header>

<script>
  const menus = [...document.querySelectorAll<HTMLElement>('[data-menu]')];
  const cerrar = (m: HTMLElement) => {
    m.querySelector<HTMLButtonElement>('[data-menu-btn]')?.setAttribute('aria-expanded', 'false');
    m.querySelector<HTMLElement>('[data-menu-panel]')?.setAttribute('hidden', '');
  };
  const abrir = (m: HTMLElement) => {
    menus.forEach((o) => o !== m && cerrar(o));
    m.querySelector<HTMLButtonElement>('[data-menu-btn]')?.setAttribute('aria-expanded', 'true');
    m.querySelector<HTMLElement>('[data-menu-panel]')?.removeAttribute('hidden');
  };
  menus.forEach((m) => {
    const btn = m.querySelector<HTMLButtonElement>('[data-menu-btn]');
    btn?.addEventListener('click', () => (btn.getAttribute('aria-expanded') === 'true' ? cerrar(m) : abrir(m)));
    m.addEventListener('focusout', (e) => {
      if (!m.contains((e as FocusEvent).relatedTarget as Node | null)) cerrar(m);
    });
  });
  document.addEventListener('click', (e) => menus.forEach((m) => !m.contains(e.target as Node) && cerrar(m)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((m) => {
      if (m.querySelector('[aria-expanded=true]')) {
        cerrar(m);
        m.querySelector<HTMLButtonElement>('[data-menu-btn]')?.focus();
      }
    });
  });
</script>
