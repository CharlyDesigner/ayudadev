---
import Icon from '@components/ui/Icon.astro';

const actual = Astro.url.pathname;
const tabs = [
  { label: 'Inicio', href: '/', icon: 'home', match: ['/'] },
  { label: 'Biblioteca', href: '/biblioteca/', icon: 'book', match: ['/biblioteca/'] },
  { label: 'Guías', href: '/guias/', icon: 'code', match: ['/guias/'] },
  { label: 'IA', href: '/ia/', icon: 'sparkles', match: ['/ia/'] },
  { label: 'Explorar', href: '/explorar/', icon: 'layout-grid', match: ['/explorar/', '/rutas/', '/fundamentos/', '/glosario/', '/hojas/', '/retos/', '/proyectos/', '/herramientas/', '/comunidad/', '/carrera/', '/noticias/', '/progreso/', '/empieza-aqui/'] },
] as const;
const activo = (t: (typeof tabs)[number]) => (t.href === '/' ? actual === '/' : t.match.some((m) => actual.startsWith(m)));
---

<nav aria-label="Navegación móvil" class="fixed inset-x-3 bottom-3 z-40 md:hidden">
  <ul class="glass flex items-center justify-around rounded-full border border-line px-1 py-1.5 shadow-[0_10px_30px_rgb(0_0_0/0.25)]">
    {tabs.map((tab) => (
      <li class="flex-1">
        <a
          href={tab.href}
          aria-current={activo(tab) ? 'page' : undefined}
          class:list={[
            'flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-full px-2 py-1 text-[11px] font-medium transition-colors',
            activo(tab) ? 'bg-surface text-accent-ink' : 'text-muted',
          ]}
        >
          <Icon name={tab.icon} class="h-5 w-5" />
          <span>{tab.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
