---
import Icon from '@components/ui/Icon.astro';

interface Props {
  id: string;
  titulo: string;
  prompt: string;
  categoria?: string;
  herramientas?: string[];
  nota?: string;
}
const { id, titulo, prompt, categoria, herramientas = [], nota } = Astro.props;
const CATEGORIAS: Record<string, string> = {
  aprender: 'Aprender',
  depurar: 'Depurar',
  explicar: 'Explicar',
  refactorizar: 'Refactorizar',
  escribir: 'Escribir',
  estudiar: 'Estudiar',
};
---

<article id={id} class="card flex flex-col gap-3 p-5" data-prompt data-categoria={categoria} data-herramientas={herramientas.join(' ')}>
  <div class="flex items-start justify-between gap-3">
    <div class="flex flex-wrap gap-1.5">
      {categoria && <span class="badge badge-accent">{CATEGORIAS[categoria] ?? categoria}</span>}
      {herramientas.map((h) => <span class="badge">{h}</span>)}
    </div>
    <button type="button" class="btn btn-secondary btn-sm shrink-0" data-copy={`#${id} [data-prompt-text]`} aria-label={`Copiar el prompt: ${titulo}`}>
      <Icon name="copy" class="h-3.5 w-3.5" /> Copiar
    </button>
  </div>
  <h3 class="text-lg font-semibold leading-snug">{titulo}</h3>
  <p data-prompt-text class="rounded-2xl border border-line bg-surface-2/60 p-4 font-mono text-[0.85rem] leading-relaxed whitespace-pre-wrap">{prompt}</p>
  {nota && <p class="text-xs text-muted">{nota}</p>}
</article>
