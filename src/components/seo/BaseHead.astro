---
import { SITE } from '@data/site';

interface Props {
  title: string;
  description: string;
  /** Ruta de la página, p. ej. "/guias/javascript/". */
  path?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = SITE.ogDefault,
  imageAlt = `${SITE.nombre}: ${SITE.lema}`,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE.url);
const canonical = new URL(path, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const pageTitle = title.includes(SITE.nombre) ? title : `${title} · ${SITE.nombre}`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.autor.nombre} />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.nombre}: novedades`} href="/rss.xml" />
<meta name="theme-color" content="#0b0b0c" />
<meta name="color-scheme" content="dark light" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.nombre} />
<meta property="og:locale" content="es_MX" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
