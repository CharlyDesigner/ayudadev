{
  "name": "ayudadev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "AyudaDev: recursos gratuitos, guías con ejemplos e IA para aprender a programar en español.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "og": "node scripts/build-og.mjs",
    "dev": "astro dev --port 4323",
    "build": "astro build",
    "preview": "astro preview --port 4323",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "check:static": "node scripts/check-static-site.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:static"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
